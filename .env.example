# Copy to .env and replace every placeholder. Do not commit .env.
SECRET_KEY=change-me
DEBUG=False
FLASK_ENV=production
APP_ENV=production
BASE_URL=http://127.0.0.1:5000

MYSQL_HOST=127.0.0.1
MYSQL_USER=timetable
MYSQL_PASSWORD=change-me
MYSQL_DB=timetable
# Several colleges on one installation: name a registry database here and leave MYSQL_DB unused.
# Each college is then created with `flask tenant create <slug> --hostname <host>`. See docs/TENANCY.md.
# TENANT_REGISTRY_DB=timetable_registry
# TENANT_CACHE_SECONDS=30

LOG_FILE=logs/app.log
# text, or json for a log shipper. Every line carries the request id and tenant.
LOG_FORMAT=text
LOG_LEVEL=INFO
QUALITY_MODEL_RETRAIN_INTERVAL_MINUTES=180
# Joint timetable solver (docs/TIMETABLE.md): CP-SAT time budget per job in seconds.
TIMETABLE_SOLVER_SECONDS=20
MAINTENANCE_MODE=False

# Workers (docs/RUNBOOK.md). The web unit sets BACKGROUND_WORKERS=False and `flask workers run` hosts them.
# A running job whose heartbeat is older than JOB_STALE_SECONDS is requeued.
JOB_STALE_SECONDS=900
# /health: 503 when the worker heartbeat is missing/stale (REQUIRE_WORKERS=true) or disk is low.
REQUIRE_WORKERS=false
WORKERS_STALE_SECONDS=180
HEALTH_MIN_FREE_MB=500
# WORKERS_HEARTBEAT_FILE=logs/workers.heartbeat

# Error alerts: ERROR-level log records go to a webhook (JSON POST) and/or mail. One per distinct message per quiet period.
# ALERT_WEBHOOK_URL=https://hooks.example/...
# ALERT_MAIL_TO=ops@example.edu
ALERT_QUIET_SECONDS=600
# Outgoing mail (alerts; notifications later).
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=timetable@example.edu
# SMTP_STARTTLS=true

# Backups (deploy/backup.sh)
# BACKUP_DIR=/var/backups/timetable
# BACKUP_KEEP_DAYS=14
# BACKUP_REMOTE=s3:bucket/timetable
# BACKUP_REMOTE_TOOL=rclone

# Sign-in lock and limits. TRUSTED_PROXY_COUNT is the number of reverse proxies
# in front of the app; leave 0 when clients connect directly.
SIGN_IN_MAX_FAILED_ATTEMPTS=5
SIGN_IN_FAILURE_WINDOW_MINUTES=15
SIGN_IN_LOCK_MINUTES=15
SIGN_IN_LIMIT_PER_ACCOUNT=10
SIGN_IN_LIMIT_PER_ADDRESS=300
SIGN_IN_UNKNOWN_LIMIT_PER_ADDRESS=20
TRUSTED_PROXY_COUNT=0

# Hour (0-23) at which yesterday's unmarked lectures are recorded as not_marked. -1 turns the worker off.
ATTENDANCE_CLOSE_DAY_HOUR=1
# Minimum attendance percentage (1-100). Students below it are listed as defaulters.
ATTENDANCE_THRESHOLD_PERCENT=75

INSTITUTION_NAME=Example College
INSTITUTION_SHORT_NAME=Example
INSTITUTION_EMAIL=admin@example.edu
INSTITUTION_PHONE=
INSTITUTION_ADDRESS=

MOBILE_SYNC_API_KEY=change-me
MOBILE_SYNC_ALLOW_LEGACY_API_KEY=False
MOBILE_SYNC_SIGNATURE_WINDOW_SECONDS=300
MOBILE_SYNC_DEFAULT_RATE_LIMIT_PER_MINUTE=120
MOBILE_SYNC_ATTENDANCE_RATE_LIMIT_MULTIPLIER=5

MOBILE_FACE_EMBEDDING_ENABLED=True
MOBILE_FACE_EMBEDDING_REQUIRE_SUCCESS=True
FACE_DETECT_CONF_THRESHOLD=0.5
FACE_DETECT_IOU_THRESHOLD=0.4
FACE_TEMPLATE_MIN_QUALITY=0.5

# Face data safeguards (docs/FACE_ATTENDANCE.md). Generate the key with `flask face generate-key`;
# templates are stored in plaintext until it is set and `flask face encrypt-templates` has run.
# FACE_TEMPLATE_KEY=
# FACE_TEMPLATE_KEY_PREVIOUS=        # only while `flask face rotate-key` is being run
FACE_CONSENT_REQUIRED=True
FACE_CONSENT_NOTICE_VERSION=2026-01
FACE_RETENTION_DAYS=30
FACE_MIN_CONFIDENCE=0.70
FACE_MIN_LIVENESS=0.50
FACE_DUPLICATE_FRAME_SECONDS=600
FACE_TEMPLATE_MAX_AGE_DAYS=730
FACE_REQUIRE_SESSION_CODE=False
FACE_SESSION_CODE_MINUTES=90

# Notifications outbox (docs/NOTIFICATIONS.md). Mail goes through the institution's SMTP account from
# Admin > Notifications when one is set, else the SMTP_* block above. Stored SMTP passwords are encrypted
# with SETTINGS_ENCRYPTION_KEY (a Fernet key; `flask face generate-key` prints one), else FACE_TEMPLATE_KEY,
# else a key derived from SECRET_KEY.
NOTIFICATIONS_ENABLED=True
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_SECONDS=300
NOTIFICATION_POLL_SECONDS=15
# SETTINGS_ENCRYPTION_KEY=

# Capabilities (docs/DESIGN_CAPABILITIES.md): optional features. Each is on only when its server flag below is on
# (default on) AND the tenant switched it on under Admin > Settings > Capabilities (or the registry default is on).
# Set a flag to false to hide that feature for every tenant on this server.
# FEATURE_TIMETABLE_PREFERENCES=true
# FEATURE_TIMETABLE_VERSIONS=true
# FEATURE_TIMETABLE_GRID=true
# FEATURE_BOOKINGS=true
# FEATURE_WORKLOAD_NORMS=true
# FEATURE_ACADEMIC_TERMS=true
# FEATURE_SYLLABUS=true
# FEATURE_ASSESSMENTS=true
# FEATURE_EXAMS=true
# FEATURE_TWO_FACTOR=true
# FEATURE_PRIVACY_TOOLS=true
# FEATURE_CHANNELS=true
# FEATURE_GUARDIANS=true
# FEATURE_CALENDAR_FEEDS=true
# FEATURE_ATTENDANCE_POLICIES=true

# Integrations (docs/INTEGRATIONS.md): public /api/v1 rate limit per API key, webhook outbox delivery, OIDC SSO.
PUBLIC_API_LIMIT_PER_MINUTE=600
WEBHOOKS_ENABLED=True
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_POLL_SECONDS=10
WEBHOOK_TIMEOUT_SECONDS=10
# Only for local development: allow http:// and private-network webhook URLs.
WEBHOOK_ALLOW_HTTP=False
WEBHOOK_ALLOW_PRIVATE=False
# SSO_REDIRECT_BASE_URL=https://college.example.edu

# Offline license (docs/RUNBOOK.md). false leaves this server unchanged when license.json is absent.
# The Docker image and deploy/setup.sh turn it on and read LICENSE_FILE.
LICENSE_REQUIRED=false
# LICENSE_FILE=/opt/timetable/app/license.json
