# Copy to .env and replace every placeholder. Do not commit .env.
SECRET_KEY=change-me
DEBUG=False
FLASK_ENV=production
APP_ENV=production
BASE_URL=http://127.0.0.1:5000

MYSQL_HOST=127.0.0.1
MYSQL_USER=timetable
MYSQL_PASSWORD=change-me
MYSQL_DB=timetable

LOG_FILE=logs/app.log
QUALITY_MODEL_RETRAIN_INTERVAL_MINUTES=180
MAINTENANCE_MODE=False

# Sign-in lock and limits. TRUSTED_PROXY_COUNT is the number of reverse proxies
# in front of the app; leave 0 when clients connect directly.
SIGN_IN_MAX_FAILED_ATTEMPTS=5
SIGN_IN_FAILURE_WINDOW_MINUTES=15
SIGN_IN_LOCK_MINUTES=15
SIGN_IN_LIMIT_PER_ACCOUNT=10
SIGN_IN_LIMIT_PER_ADDRESS=300
SIGN_IN_UNKNOWN_LIMIT_PER_ADDRESS=20
TRUSTED_PROXY_COUNT=0

# Hour (0-23) at which yesterday's unmarked lectures are recorded as not_marked. -1 turns the worker off.
ATTENDANCE_CLOSE_DAY_HOUR=1
# Minimum attendance percentage (1-100). Students below it are listed as defaulters.
ATTENDANCE_THRESHOLD_PERCENT=75

INSTITUTION_NAME=Example College
INSTITUTION_SHORT_NAME=Example
INSTITUTION_EMAIL=admin@example.edu
INSTITUTION_PHONE=
INSTITUTION_ADDRESS=

MOBILE_SYNC_API_KEY=change-me
MOBILE_SYNC_ALLOW_LEGACY_API_KEY=False
MOBILE_SYNC_SIGNATURE_WINDOW_SECONDS=300
MOBILE_SYNC_DEFAULT_RATE_LIMIT_PER_MINUTE=120
MOBILE_SYNC_ATTENDANCE_RATE_LIMIT_MULTIPLIER=5

MOBILE_FACE_EMBEDDING_ENABLED=True
MOBILE_FACE_EMBEDDING_REQUIRE_SUCCESS=True
FACE_DETECT_CONF_THRESHOLD=0.5
FACE_DETECT_IOU_THRESHOLD=0.4
FACE_TEMPLATE_MIN_QUALITY=0.5
