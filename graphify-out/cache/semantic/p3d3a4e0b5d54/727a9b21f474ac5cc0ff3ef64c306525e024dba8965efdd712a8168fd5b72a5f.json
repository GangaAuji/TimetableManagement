d", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "api/web/responses.py is the shared { success, data } and { success, error } shapes."}, {"id": "docs_modules_services", "label": "Service layer", "file_type": "code", "source_file": "docs/modules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "services holds the work the API modules and workers call."}, {"id": "docs_modules_signin_services", "label": "Sign-in services", "file_type": "code", "source_file": "docs/modules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "login.py, registration.py, invitations.py, and sso.py: student, teacher, and admin sign-in, invitation registration, and OpenID Connect."}, {"id": "docs_modules_timetable_services", "label": "Timetable services", "file_type": "code", "source_file": "docs/modules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "timetable/generator.py, timetable/joint_solver.py, timetable_slots.py, timetable_jobs.py, timetable_quality_service.py, and lab_batches.py: generation, manual slots, the job queue, the quality model, and lab batches."}, {"id": "docs_modules_attendance_services", "label": "Attendance services", "file_type": "code", "source_file": "docs/modules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "attendance_calc.py, lecture_sessions.py, teacher_attendance.py, student_portal.py, and attendance_admin/_common.py: percentages and defaulters, sessions, teacher and student views, and mobile log promotion."}, {"id": "docs_modules_report_services", "label": "Report services", "file_type": "code", "source_file": "docs/modules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "export_jobs.py and reports_admin/: queued CSV, Excel, and PDF jobs, report datasets, and NAAC/NBA templates."}, {"id": "docs_modules_worker_services", "label": "Notification and worker services", "file_type": "code", "source_file": "docs/modules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "notifications.py, webhooks.py, job_claims.py, and worker_process.py: the outboxes, the claim pattern, and the worker threads."}, {"id": "docs_modules_integration_services", "label": "Integration services", "file_type": "code", "source_file": "docs/modules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "api_keys.py, webhooks.py, sso.py, and secrets_at_rest.py: public API keys, webhook endpoints, SSO settings, and encryption of stored secrets."}, {"id": "docs_modules_people_services", "label": "People and access services", "file_type": "code", "source_file": "docs/modules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "users.py, user_actions.py, user_permissions.py, faculty_admin.py, profile.py, and admin_queries.py."}, {"id": "docs_modules_audit_service", "label": "Audit log service", "file_type": "code", "source_file": "docs/modules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "audit_logs.py: activity, sessions, and failed sign-ins."}, {"id": "docs_modules_face_service", "label": "Face service", "file_type": "code", "source_file": "docs/modules.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "face/: embeddings, encrypted templates, consent, and liveness safeguards."}, {"id": "docs_modules_academic_rules", "label": "academic_rules", "file_type": "code", "source_file": "docs/m