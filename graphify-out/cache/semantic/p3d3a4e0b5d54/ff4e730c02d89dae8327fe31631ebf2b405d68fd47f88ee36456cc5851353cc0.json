{"nodes": [{"id": "docs_application_document", "label": "How the application works", "file_type": "document", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Timetable Management System is the college workspace for people, teaching setup, timetables, attendance, and reports."}, {"id": "docs_application_system", "label": "Timetable Management System", "file_type": "concept", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Staff run the college from the admin area. Teachers and students use a smaller portal for their own classes."}, {"id": "docs_application_roles", "label": "Sign-in roles", "file_type": "concept", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Students and teachers sign in at / or /login and land on the portal. Admin, Super Admin, and HOD sign in at /admin/login and land on /admin. After an admin signs in, / sends them to /admin. The sidebar only lists pages the account may open. Super Admin can open every staff page. Other staff need the matching permission. Teachers and students cannot open /admin pages."}, {"id": "docs_application_vite", "label": "Vite dev server", "file_type": "code", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vite on 127.0.0.1:5173 serves the React app and proxies /api, /login, /admin/login, /register, and /logout to Flask."}, {"id": "docs_application_flask", "label": "Flask API", "file_type": "code", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flask on 127.0.0.1:5000 serves JSON under /api, sign-in posts under /login and /admin/login, and mobile sync under /mobile-sync/v1."}, {"id": "docs_application_mysql", "label": "MySQL", "file_type": "concept", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The service reads or writes MySQL. The browser reaches it only through Flask."}, {"id": "docs_application_create_app", "label": "create_app", "file_type": "code", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app.py starts Flask through create_app() in app_factory.py."}, {"id": "docs_application_react_router", "label": "React router", "file_type": "code", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The React router lives in frontend/src/app/router.tsx."}, {"id": "docs_application_root_gate", "label": "RootGate", "file_type": "code", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RootGate in SessionGate.tsx decides whether to show a sign-in form or the signed-in shell."}, {"id": "docs_application_page_access", "label": "page-access.ts", "file_type": "code", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "page-access.ts checks the role and permission for a path before the signed-in page calls the API."}, {"id": "docs_application_request_pipeline", "label": "Signed-in request pipeline", "file_type": "rationale", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The page asks GET /api/session and GET /api/branding. An empty session keeps the sign-in form. Otherwise page-access.ts checks the path, the page calls /api, the API requires a signed-in account, the route checks its permission or role, and the route calls a service that reads or writes MySQL."}, {"id": "docs_application_json_envelope", "label": "JSON response envelope", "file_type": "rationale", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The JSON response is { success, data } or { success, error: { code, message } }. Writes also need the security token, a same-origin browser request, and a JSON body. Profile photos and settings uploads are the multipart exceptions."}, {"id": "docs_application_public_reads", "label": "Unauthenticated JSON reads", "file_type": "concept", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only JSON reads that work without a session are GET /api/branding, GET /api/csrf-token, GET /api/session, and GET /api/register/<token>. They exist so the sign-in page and an invitation link can render. The register preview does not need a session. Sign-in is POST /login for students and teachers and POST /admin/login for staff. Registration is POST /register/<token>. Everything else under /api returns 401 until a session exists. Public sign-in and registration are rate limited, and signed-in API calls have a higher per-account limit."}, {"id": "docs_application_legacy_pages", "label": "Legacy Flask pages", "file_type": "rationale", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This document says older Flask views under /admin, /teacher, and /student are still registered. A browser GET for those pages is turned into the React route by ui/pages.py. The React app is the interface people use."}, {"id": "docs_application_ui_pages", "label": "ui/pages.py", "file_type": "code", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ui/pages.py turns a browser GET for an older Flask page into the React route."}, {"id": "docs_application_mobile_sync", "label": "Mobile sync API", "file_type": "concept", "source_file": "docs/application.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mobile devices use /mobile-sync/v1 and are separate from /api."}], "edges": [{"source": "docs_application_system", "target": "docs_application_roles", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/application.md", "source_location": null, "weight": 1.0}, {"source": "docs_application_system", "target": "docs_application_vite", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/application.md", "source_location": null, "weight": 1.0}, {"source": "docs_application_system", "target": "docs_application_flask", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/application.md", "source_location": null, "weight": 1.0}, {"source": "docs_application_system", "target": "docs_application_mysql", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/application.md", "source_location": null, "weight": 1.0}, {"source": "docs_application_vite", "target": "docs_application_flask", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/application.md", "source_location": null, "weight": 1.0}, {"source": "docs_application_flask", "target": "docs_application_mysql", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "con