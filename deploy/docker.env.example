# Copy to deploy/docker.env. Do not commit that file.
MYSQL_DB=timetable
MYSQL_USER=timetable
MYSQL_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-root
SECRET_KEY=change-me
DEBUG=False
FLASK_ENV=production
# true on a packaged server. false runs with no license file.
LICENSE_REQUIRED=true
# Host path of the signed license, mounted read-only at /license/license.json.
# LICENSE_FILE=./license.json
# Set to 1 for the first boot only. Later upgrades use deploy/upgrade.sh.
TIMETABLE_AUTO_UPGRADE=0
HTTP_PORT=80
