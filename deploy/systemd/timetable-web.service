[Unit]
Description=Timetable Management web tier (gunicorn)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=notify
User=timetable
Group=timetable
WorkingDirectory=/opt/timetable/app
EnvironmentFile=/opt/timetable/app/.env
Environment=BACKGROUND_WORKERS=False
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/timetable/venv/bin/gunicorn --config /opt/timetable/app/deploy/gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=40
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/timetable/app/logs /opt/timetable/app/uploads /opt/timetable/app/static/uploads /opt/timetable/app/ml_models/models

[Install]
WantedBy=multi-user.target
